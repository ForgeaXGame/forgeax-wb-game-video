{
  "schemaVersion": 1,
  "id": "@forgeax-plugin/wb-anim",
  "version": "0.1.0",
  "kind": "workbench",
  "displayName": {
    "zh": "动画",
    "en": "Animation"
  },
  "description": {
    "zh": "动画工作台 · spine 绑定 + skeleton retargeting + sprite sheet 浏览 · 后续接 character-editor/spine + 3D_Anim_Skeleton。",
    "en": "Animation workbench. Spine binding + skeleton retargeting + sprite sheet browsing. Will host character-editor/spine + 3D_Anim_Skeleton."
  },
  "provides": {
    "workbench": {
      "id": "anim",
      "lens": "by-category",
      "icon": "🎬",
      "position": 160,
      "panelSize": "lg",
      "matchProduces": [
        "**/anim/**",
        "**/*.spine.json",
        "**/*.sheet.png"
      ]
    },
    "tools": [
      {
        "id": "anim:generate-spine",
        "args": "./schemas/generate-spine.args.json",
        "returns": "./schemas/generate-spine.returns.json",
        "exposedToAI": true,
        "description": { "zh": "Spine 拆件绑骨 · 拆 → 绑 → 动作工坊 → skel/json 导出" }
      },
      {
        "id": "anim:generate-video",
        "args": "./schemas/generate-video.args.json",
        "returns": "./schemas/generate-video.returns.json",
        "exposedToAI": true,
        "description": { "zh": "视频角色 · 序列帧 / 场景展示" }
      }
    ]
  },
  "entry": {
    "frontend": "./src/panel.tsx",
    "backend": "./server/api-plugin.ts"
  },
  "requestedEnv": [
    "KLING_ACCESS_KEY",
    "KLING_SECRET_KEY"
  ],
  "experimental": true
}
