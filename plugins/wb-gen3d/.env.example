# wb-gen3d provider credentials. Copy to `.env` (gitignored) and fill values.
# NEVER commit real keys. The plugin reads these via server/env.ts.
#
# LiteLLM gateway key comes from Studio global .env (Settings → API Keys:
# ANTHROPIC_API_KEY or LITELLM_PROXY_KEY). Do NOT set LITELLM_PROXY_* here.

# Optional tuning (defaults shown).
# HUNYUAN_DEFAULT_FACE_COUNT=30000
# HUNYUAN_POLL_INTERVAL_MS=5000
# HUNYUAN_POLL_TIMEOUT_MS=600000
# HUNYUAN_RATE_LIMIT_PER_MIN=3
# MESHY_DEFAULT_POLYCOUNT=30000
# MESHY_POLL_INTERVAL_MS=5000
# MESHY_POLL_TIMEOUT_MS=600000
# MESHY_RATE_LIMIT_PER_MIN=3

# Master switch. Real provider calls are OFF unless this is exactly "1".
# With this unset/0, generation falls back to deterministic mock (quota-safe).
GEN3D_ENABLE_REAL_PROVIDERS=0

# COS (cloud object storage) — hosts local input images so URL-fetching providers
# (Hunyuan/Meshy) can reach them. NOT gated by GEN3D_ENABLE_REAL_PROVIDERS:
# upload works in mock mode too. When unset, gen3d:upload-image returns
# cos_not_configured and the UI asks the user to paste an image URL instead.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
# Presigned URL lifetime in seconds (default 86400 = 24h).
# COS_SIGN_EXPIRES_SEC=86400
