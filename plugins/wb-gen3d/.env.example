# wb-gen3d provider credentials. Copy to `.env` (gitignored) and fill values.
# NEVER commit real keys. The plugin reads these via server/env.ts.

# Hunyuan workflow (司内网 OpenAPI). Bearer auth, no request signing.
# Host is plain http (内网). Key is a UUID.
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=http://hunyuanapi.woa.com

# Optional tuning (defaults shown).
# HUNYUAN_POLL_INTERVAL_MS=5000
# HUNYUAN_POLL_TIMEOUT_MS=600000
# HUNYUAN_RATE_LIMIT_PER_MIN=3

# Master switch. Real provider calls are OFF unless this is exactly "1".
# With this unset/0, generation falls back to deterministic mock (quota-safe).
GEN3D_ENABLE_REAL_PROVIDERS=0
