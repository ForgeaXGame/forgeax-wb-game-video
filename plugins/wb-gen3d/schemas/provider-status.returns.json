{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "gen3d:provider-status returns",
  "type": "object",
  "properties": {
    "ok": { "const": true },
    "mode": { "const": "static-m1" },
    "quotaSafe": { "const": true },
    "generatedAt": { "type": "string" },
    "rubric": {
      "type": "array",
      "items": {
        "enum": ["geometry", "topology", "texture", "pbr", "prompt_fidelity"]
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "providerId": {
            "enum": ["meshy", "hunyuan_workflow", "hunyuan_rest", "future"]
          },
          "providerName": { "type": "string" },
          "capability": { "type": "string" },
          "sourceStatus": { "type": "string" },
          "exposure": {
            "enum": ["planned", "mock-first", "experimental", "hidden", "blocked"]
          },
          "notes": { "type": "string" }
        },
        "required": ["providerId", "providerName", "capability", "sourceStatus", "exposure", "notes"],
        "additionalProperties": false
      }
    }
  },
  "required": ["ok", "mode", "quotaSafe", "generatedAt", "rubric", "capabilities"],
  "additionalProperties": false
}
