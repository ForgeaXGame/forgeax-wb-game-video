{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "gen3d:list-results returns",
  "type": "object",
  "properties": {
    "ok": { "const": true },
    "mode": { "const": "static-m1" },
    "quotaSafe": { "const": true },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "providerId": {
            "enum": ["meshy", "hunyuan_workflow", "hunyuan_rest", "future"]
          },
          "providerName": { "type": "string" },
          "mode": { "type": "string" },
          "prompt": { "type": "string" },
          "promptCategory": { "enum": ["character", "prop", "scene"] },
          "status": { "enum": ["mock", "cached", "succeeded", "failed"] },
          "artifactKind": { "enum": ["glb", "fbx", "image", "none"] },
          "quotaConsumed": { "type": "boolean" },
          "quality": {
            "type": "object",
            "properties": {
              "geometry": { "type": ["number", "null"] },
              "topology": { "type": ["number", "null"] },
              "texture": { "type": ["number", "null"] },
              "pbr": { "type": ["number", "null"] },
              "prompt_fidelity": { "type": ["number", "null"] },
              "total": { "type": ["number", "null"] }
            },
            "required": ["geometry", "topology", "texture", "pbr", "prompt_fidelity", "total"],
            "additionalProperties": false
          },
          "notes": { "type": "string" }
        },
        "required": [
          "id",
          "providerId",
          "providerName",
          "mode",
          "prompt",
          "promptCategory",
          "status",
          "artifactKind",
          "quotaConsumed",
          "quality",
          "notes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["ok", "mode", "quotaSafe", "results"],
  "additionalProperties": false
}
