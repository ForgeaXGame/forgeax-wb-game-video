{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "gen3d:generate-meshy-text-mock args",
  "type": "object",
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1,
      "description": "Text prompt for the mock Meshy text-to-3D result."
    },
    "promptCategory": {
      "enum": ["character", "prop", "scene"],
      "default": "prop"
    },
    "enablePbr": {
      "type": "boolean",
      "default": true
    },
    "targetPolycount": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 300000,
      "default": 30000
    }
  },
  "required": ["prompt"],
  "additionalProperties": false
}
