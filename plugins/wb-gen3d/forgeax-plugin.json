{
  "schemaVersion": 1,
  "id": "@forgeax-plugin/wb-gen3d",
  "version": "0.1.0",
  "kind": "workbench",
  "displayName": {
    "zh": "3D 角色生成",
    "en": "3D Character Generation"
  },
  "description": {
    "zh": "Hunyuan3D / Meshy 等 provider 的 3D 资产生成入口：选 provider + 输入，产出持久化的游戏可用 3D 资产 manifest。",
    "en": "3D asset generation entrypoint for providers like Hunyuan3D and Meshy: pick a provider and input, produce durable game-ready 3D asset manifests."
  },
  "author": { "name": "forgeax", "email": "dev@forgeax.local" },
  "icon": "🧪",
  "keywords": ["3d", "generation", "meshy", "hunyuan3d", "asset", "glb"],

  "provides": {
    "workbench": {
      "id": "wb-gen3d",
      "lens": "by-category",
      "icon": "🧪",
      "position": 155,
      "panelSize": "lg",
      "surface": "split",
      "panes": {
        "left": { "width": 320, "scrollable": true },
        "center": { "minHeight": 600, "scrollable": true }
      },
      "bus": { "surfaceId": "gen3d" },
      "matchProduces": [
        "**/.forgeax/assets/gen3d/**"
      ]
    },
    "tools": [
      {
        "id": "gen3d:provider-status",
        "args": "./schemas/provider-status.args.json",
        "returns": "./schemas/provider-status.returns.json",
        "exposedToAI": true,
        "description": {
          "zh": "读取 3D 生成供应商能力矩阵；返回静态、无配额数据。",
          "en": "Read the 3D generation provider capability matrix. Returns static no-quota data."
        }
      },
      {
        "id": "gen3d:list-assets",
        "args": "./schemas/list-assets.args.json",
        "returns": "./schemas/list-assets.returns.json",
        "exposedToAI": true,
        "description": {
          "zh": "列出已生成的持久化 3D 资产 manifest，可按 provider 过滤。",
          "en": "List durable generated 3D asset manifests, optionally filtered by provider."
        }
      },
      {
        "id": "gen3d:generate-meshy-text-mock",
        "args": "./schemas/generate-meshy-text-mock.args.json",
        "returns": "./schemas/generate-meshy-text-mock.returns.json",
        "exposedToAI": true,
        "description": {
          "zh": "生成确定性的 Meshy 文生 3D mock 资产并落盘为持久 manifest；不调用远端。",
          "en": "Generate a deterministic Meshy text-to-3D mock asset persisted as a durable manifest, with no remote calls."
        }
      }
    ],
    "events": [
      { "name": "gen3d.provider.status-read" },
      { "name": "gen3d.assets.listed" }
    ]
  },

  "entry": {
    "backend": "./server/tool-handlers.ts",
    "frontend": "./dist/index.html",
    "standalone": {
      "start": "npm run dev",
      "port": 15175,
      "readyProbe": "/",
      "dev": { "watch": true, "hmr": true },
      "embeddedAlso": false,
      "devOnly": false
    }
  },

  "permissions": [],
  "hot": false,
  "experimental": true,
  "compatibleWith": { "forgeax-bus": "^1.0.0" }
}
