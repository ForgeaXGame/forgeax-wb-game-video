{
  "schemaVersion": 1,
  "id": "@kubeela-plugin/cli-codex",
  "version": "0.0.1",
  "kind": "cli-provider",
  "displayName": { "zh": "OpenAI Codex", "en": "OpenAI Codex CLI" },
