{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "aiasset:get-credentials returns",
  "type": "object",
  "properties": {
    "ok": { "const": true },
    "realProvidersEnabled": { "type": "boolean" },
    "credentials": {
      "type": "object",
      "description": "Masked credential state. Secret keys are masked (first4...last4) or null; addresses are plaintext or null. Never plaintext secrets.",
      "properties": {
        "MESHY_API_KEY": { "type": ["string", "null"] },
        "MESHY_BASE_URL": { "type": ["string", "null"] },
        "COS_SECRET_ID": { "type": ["string", "null"] },
        "COS_SECRET_KEY": { "type": ["string", "null"] },
        "COS_BUCKET": { "type": ["string", "null"] },
        "COS_REGION": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "required": ["ok", "realProvidersEnabled", "credentials"],
  "additionalProperties": true
}
