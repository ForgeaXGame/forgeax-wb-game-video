{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "aiasset generate returns",
  "type": "object",
  "properties": {
    "ok": { "const": true },
    "cacheKey": { "type": "string" },
    "cacheHit": { "type": "boolean" },
    "usedMock": {
      "type": "boolean",
      "description": "True when Meshy was not configured and a deterministic quota-safe mock was used."
    },
    "manifest": {
      "type": "object",
      "description": "The durable Gen3DAssetManifest (assetPath identity + files + readiness). Permissive shape; see shared/manifest.ts.",
      "properties": {
        "manifestVersion": { "const": 1 },
        "assetPath": { "type": "string" },
        "assetSlot": { "enum": ["characters", "meshes"] },
        "provider": { "type": "string" },
        "providerMode": { "enum": ["mock", "real"] },
        "mode": { "type": "string" }
      },
      "required": ["manifestVersion", "assetPath", "provider", "providerMode", "mode"],
      "additionalProperties": true
    }
  },
  "required": ["ok", "cacheKey", "cacheHit", "usedMock", "manifest"],
  "additionalProperties": true
}
