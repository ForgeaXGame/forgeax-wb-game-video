{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "aiasset:list-assets args",
  "type": "object",
  "properties": {
    "slug": { "type": "string", "description": "Active game slug. Required." },
    "assetSlot": {
      "type": "string",
      "enum": ["characters", "meshes"],
      "description": "Optional filter; omit to list all slots."
    }
  },
  "required": ["slug"],
  "additionalProperties": false
}
