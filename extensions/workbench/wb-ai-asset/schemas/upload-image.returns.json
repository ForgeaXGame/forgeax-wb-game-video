{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "aiasset:upload-image returns",
  "type": "object",
  "properties": {
    "ok": { "const": true },
    "url": { "type": "string", "description": "Time-limited presigned COS URL for Meshy to fetch." },
    "bytes": { "type": "integer", "minimum": 0 },
    "sha256": { "type": "string" },
    "expiresInSec": { "type": "integer", "minimum": 0 }
  },
  "required": ["ok", "url", "bytes", "sha256", "expiresInSec"],
  "additionalProperties": true
}
